{
  "name": "agent",
  // docker buildx build --platform linux/arm64,linux/amd64 -t ghcr.io/mrexodia/agent/devcontainer:latest --push .
  "image": "ghcr.io/mrexodia/agent/devcontainer:latest",
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cmake-tools",
        "EditorConfig.EditorConfig",
        "ms-vscode.cpptools",
        "esbenp.prettier-vscode",
        "ms-python.python",
        "mathematic.vscode-pdf",
        "marp-team.marp-vscode",
        "humao.rest-client"
      ]
    },
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    }
  },
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/build:${containerEnv:PATH}"
  },
  "postCreateCommand": "${containerWorkspaceFolder}/.devcontainer/post-create.sh"
}